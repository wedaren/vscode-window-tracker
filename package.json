{
  "name": "vscode-window-tracker",
  "displayName": "vscode-window-tracker",
  "publisher": "wedaren",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["*"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-window-tracker-container",
          "title": "Window Tracker",
          "icon": "resources/project-manager.svg"
        }
      ]
    },
    "views": {
      "vscode-window-tracker-container": [
        {
          "id": "vscode-window-tracker.windowsView",
          "name": "Window Tracker"
        }
      ]
    },
    "configuration": {
      "title": "vscode-window-tracker",
      "properties": {
        "vscode-window-tracker.preferDaemon": {
          "type": "boolean",
          "default": false,
          "description": "When true, prefer a local daemon file as authoritative source (if available)."
        },
        "vscode-window-tracker.daemonFile": {
          "type": "string",
          "default": "~/.vscode-window-daemon.json",
          "description": "Path to a local daemon JSON file (tilde expanded)."
        },
        "vscode-window-tracker.trackerDir": {
          "type": "string",
          "default": "~/.vscode-window-tracker",
          "description": "Fallback directory containing tracker JSON files."
        },
        "vscode-window-tracker.idleThresholdMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Minutes of inactivity before a window is considered 'idle'."
        },
        "vscode-window-tracker.heartbeatIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Heartbeat interval in seconds for refreshing the view."
        },
        "vscode-window-tracker.groupThreshold": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "description": "When number of windows exceeds this threshold, view groups by state."
        }
        ,
        "vscode-window-tracker.trackerFileStaleMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Ignore tracker files whose lastActive is older than this many minutes."
        },
        "vscode-window-tracker.trackerAutoCleanup": {
          "type": "boolean",
          "default": true,
          "description": "When true, remove stale tracker files from the tracker directory on activation."
        }
      }
    },
    "commands": [
      {
        "command": "vscode-window-tracker.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-window-tracker.reveal",
        "title": "Reveal",
        "icon": "$(eye)"
      },
      {
        "command": "vscode-window-tracker.copyPath",
        "title": "Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "vscode-window-tracker.addProject",
        "title": "Add Project",
        "icon": "$(add)"
      },
      {
        "command": "vscode-window-tracker.removeProject",
        "title": "Remove Project",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscode-window-tracker.refresh",
          "when": "view == vscode-window-tracker.windowsView",
          "group": "navigation"
        }
        ,
        {
          "command": "vscode-window-tracker.addProject",
          "when": "view == vscode-window-tracker.windowsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-window-tracker.reveal",
          "when": "viewItem =~ /windowItem(:|$)/ && view == vscode-window-tracker.windowsView",
          "group": "inline@1"
        },
        {
          "command": "vscode-window-tracker.addProject",
          "when": "viewItem == 'windowItem:tracked:allowAdd' && view == vscode-window-tracker.windowsView",
          "group": "inline@1"
        },
        {
          "command": "vscode-window-tracker.removeProject",
          "when": "viewItem == 'windowItem:added' && view == vscode-window-tracker.windowsView",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
